# Copy this file to .env and fill in the values. .env is gitignored.

# Cloudflare Tunnel connector token for the cloudflared service.
# From Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> Configure,
# the token in the "docker run" install command. This is NOT the tunnel ID.
# After changing it: docker compose up -d --force-recreate cloudflared
CLOUDFLARE_TUNNEL_TOKEN=
